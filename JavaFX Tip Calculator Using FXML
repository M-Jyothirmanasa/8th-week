2. Controller Class: TipCalculatorController.java
This class handles button clicks, performs the calculation, validates the input, and clears the fields.

java

import javafx.fxml.FXML;
import javafx.scene.control.Label;
import javafx.scene.control.TextField;

public class TipCalculatorController {

    @FXML
    private TextField billAmountField;

    @FXML
    private TextField tipPercentageField;

    @FXML
    private Label tipAmountLabel;

    @FXML
    private Label errorLabel;

    @FXML
    private void calculateTip() {
        try {
            double billAmount = Double.parseDouble(
                billAmountField.getText().trim()
            );

            double tipPercentage = Double.parseDouble(
                tipPercentageField.getText().trim()
            );

            if (!Double.isFinite(billAmount)
                    || !Double.isFinite(tipPercentage)
                    || billAmount < 0
                    || tipPercentage < 0) {
                throw new IllegalArgumentException();
            }

            double tip = billAmount * tipPercentage / 100.0;

            tipAmountLabel.setText(
                String.format("Tip Amount: $%.2f", tip)
            );

            errorLabel.setText("");

        } catch (NumberFormatException e) {
            tipAmountLabel.setText("");
            errorLabel.setText(
                "Error: Invalid input. Please enter numbers."
            );

        } catch (IllegalArgumentException e) {
            tipAmountLabel.setText("");
            errorLabel.setText(
                "Error: Enter non-negative numeric values."
            );
        }
    }

    @FXML
    private void reset() {
        billAmountField.clear();
        tipPercentageField.clear();
        tipAmountLabel.setText("Tip Amount: $0.00");
        errorLabel.setText("");
    }
}
3. Main Application Class: TipCalculatorApp.java
This class loads the FXML file and displays the JavaFX window.

java

import javafx.application.Application;
import javafx.fxml.FXMLLoader;
import javafx.scene.Scene;
import javafx.stage.Stage;

public class TipCalculatorApp extends Application {

    @Override
    public void start(Stage primaryStage) throws Exception {
        FXMLLoader loader = new FXMLLoader(
            getClass().getResource("tip_calculator.fxml")
        );

        Scene scene = new Scene(loader.load());

        primaryStage.setTitle("Tip Calculator");
        primaryStage.setScene(scene);
        primaryStage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }
}
